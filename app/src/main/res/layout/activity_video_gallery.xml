<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Compare mode header: close + instruction. Hidden otherwise -->
    <LinearLayout
        android:id="@+id/compareHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/cancelCompareButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/button_circle_background"
            android:src="@drawable/ic_close"
            android:contentDescription="Cancel compare" />

        <TextView
            android:id="@+id/compareInstructions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Pick 2 clips to compare"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="112dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/compareHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No videos yet\n\nStart riding to capture some footage,\nor import a clip from your phone."
        android:textColor="#FFFFFF"
        android:padding="24dp"
        android:clickable="true"
        android:focusable="true"
        android:textSize="16sp"
        android:textAlignment="center"
        android:lineSpacingMultiplier="1.5"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@drawable/controls_gradient_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom controls: Import circle + Compare pill (the pill alone, centred, in compare mode) -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/importButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/button_circle_background"
            android:src="@drawable/ic_import"
            app:tint="#FFFFFF"
            android:contentDescription="Import video" />

        <TextView
            android:id="@+id/compareButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:drawableStart="@drawable/ic_compare"
            android:drawablePadding="8dp"
            android:background="@drawable/mode_pill_background"
            android:text="Compare"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:contentDescription="Compare Videos" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
